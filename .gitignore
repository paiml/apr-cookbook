# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
book/book/
examples/advanced/rag_pipeline.proptest-regressions

# PMAT
.pmat/backup/
.pmat-qa/
.pmat/context.idx/
.pmat/workspace.idx/
.pmat/deps-cache.json
# Per-session SQLite cache + WAL/shared-memory transients (PMAT-062)
.pmat/context.db
.pmat/context.db-shm
.pmat/context.db-wal
.pmat/workspace.db
.pmat/workspace.db-shm
.pmat/workspace.db-wal
# Generated project context snapshot (pmat context --output deep-context.md)
deep-context.md
# Per-commit session metadata written by `pmat work start` (PMAT-062)
.pmat-metrics/commit-*.json
# pv (aprender-contracts-cli) local lint cache
.pv/
contracts/.pv/
.cargo/config.toml

# Lean build artifacts (PMAT-047)
lean/.lake/
lean/lake-manifest.json
